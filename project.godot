; Project game moi, dung lai bo xuong + hoat anh da xuat tu ban goc.
; Art trong assets_ref/ chi la PLACEHOLDER khi dang lam — phai thay het
; truoc khi phat hanh (xem README cua brave-cross).

config_version=5

[application]

config/name="BraveCross — game moi"
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
